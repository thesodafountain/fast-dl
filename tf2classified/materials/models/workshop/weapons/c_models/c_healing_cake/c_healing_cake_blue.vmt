"VertexlitGeneric"
{
	"$basetexture" "models/workshop/weapons/c_models/c_healing_cake/c_healing_cake_blue"
	"$bumpmap" "models/workshop/weapons/c_models/c_healing_cake/c_healing_cake_nmap"
	"$phong" "1"
	"$phongexponent" "15"
	"$phongboost" "2.5"	
	"$lightwarptexture" "models/player/pyro/pyro_lightwarp"
	"$phongfresnelranges"	"[.25 .5 1]"
	"$halflambert" "1"
	"$envmap" "env_cubemap"
	"$envmaptint" "[.03 .03 .03]"
	"$normalmapalphaenvmapmask" "1"


	"$rimlight" "1"
	"$rimlightexponent" "4"	
	"$rimlightboost" "2"
	"$basephongexponent" "25"
	"$basephongboost" "5"


	"$glowcolor" "1"


	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}









