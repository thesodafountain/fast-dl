"VertexlitGeneric"
{
	"$baseTexture" "models\weapons\c_items/c_big_mean_mother_hubbard"

	"$phong" "1"
	"$phongexponent" "15"
	"$phongboost" "0"	
	"$phongexponentfactor"  "150"
	"$phongalbedotint" "1"
	"$lightwarptexture" "models/lightwarps/softened_weapon_lightwarp"			
	"$phongfresnelranges"	"[.3 .5 3]"
	"$halflambert" "1"
	
	//"$envmap" "env_cubemap"
	//"$envmaptint" "[.05 .05 .05]"
	
	"$tempvar" "0"

	"$basemapalphaphongmask" "1"
	
	"$rimlight" "1"						
	"$rimlightexponent" "1"				
	"$rimlightboost" "2.25"
	"$rimmask" "1"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}